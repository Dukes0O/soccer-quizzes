  "scenes": [
    {
      "type": "title",
      "id": "title",
      "vo": "Back to the Keeper. Episode two: the back-pass rule. When can the keeper use their hands, and when is it feet only?"
    },
    {
      "type": "steps",
      "id": "steps",
      "view": { "x": -40, "y": 200, "w": 720, "h": 590 },
      "steps": [
        {
          "kicker": "The situation",
          "heading": "Kicked back",
          "sub": "Your team-mate passes it back with their foot, on purpose.",
          "vo": "Your team-mate kicks the ball back to you on purpose. You're the keeper, inside your own box.",
          "board": {
            "players": [
              { "id": "gk", "team": "keeper", "label": "GK", "path": [[0, 470, 600]] },
              { "id": "d", "team": "us", "label": "5", "path": [[0, 520, 380]] },
              { "id": "a", "team": "them", "label": "A", "path": [[0, 560, 300]] }
            ],
            "ball": [[0, 508, 398], [0.3, 508, 398], [0.62, 478, 585]],
            "lines": [{ "from": [508, 402], "to": [480, 570], "color": "green", "t": [0.3, 0.58] }]
          }
        },
        {
          "kicker": "You choose",
          "heading": "Hands or feet?",
          "sub": "Can the keeper pick it up?",
          "countdown": 3,
          "vo": "Can the keeper pick it up? Say hands, or feet.",
          "board": {
            "players": [
              { "id": "gk", "team": "keeper", "label": "GK", "path": [[0, 470, 600]] },
              { "id": "d", "team": "us", "label": "5", "path": [[0, 520, 380]] },
              { "id": "a", "team": "them", "label": "A", "path": [[0, 560, 300]] }
            ],
            "ball": [[0, 478, 585]],
            "bubbles": [{ "at": "gk", "text": "HANDS?", "color": "amber", "below": true, "t": [0.05, 0.1] }]
          }
        },
        {
          "kicker": "The answer",
          "heading": "Feet only",
          "sub": "Pick it up: indirect free kick to them, from where it was handled.",
          "vo": "Feet only. If the keeper picks it up, the other team gets an indirect free kick from the spot where the keeper touched it. If that's inside the small box, the kick moves out to the edge of the small box. It's so close to goal that our whole team may have to stand on the goal line, between the posts. Don't pick it up.",
          "board": {
            "players": [
              { "id": "gk", "team": "keeper", "label": "GK", "path": [[0, 470, 600], [0.5, 480, 698]] },
              { "id": "d", "team": "us", "label": "5", "path": [[0, 520, 380], [0.5, 520, 698]], "faces": [[0, "down"], [0.45, "up"]] },
              { "id": "p", "team": "us", "label": "4", "path": [[0, 250, 420], [0.5, 440, 698]], "faces": [[0, "up"]] },
              { "id": "a", "team": "them", "label": "A", "path": [[0, 560, 300], [0.42, 500, 560]] },
              { "id": "a2", "team": "them", "label": "B", "path": [[0, 300, 330], [0.42, 420, 540]] }
            ],
            "ball": [[0, 478, 585], [0.35, 480, 600]],
            "marks": [{ "kind": "cross", "at": [400, 600], "t": [0.08, 0.12] }],
            "tags": [
              { "at": [320, 250], "text": "INDIRECT FREE KICK", "color": "amber", "size": 38, "t": [0.16, 0.2] },
              { "at": [320, 775], "text": "OUR TEAM ON THE GOAL LINE", "color": "red", "t": [0.56, 0.6] }
            ]
          }
        },
        {
          "kicker": "Same rule",
          "heading": "Throw-in back",
          "sub": "A throw-in straight to the keeper: feet only too.",
          "vo": "Same with a throw-in. If your team-mate throws it straight to you, it's feet only.",
          "board": {
            "players": [
              { "id": "t", "team": "us", "label": "3", "path": [[0, -10, 470], [0.15, 18, 470]], "faces": [[0, "up"]] },
              { "id": "gk", "team": "keeper", "label": "GK", "path": [[0, 480, 698], [0.2, 380, 600]] },
              { "id": "d", "team": "us", "label": "5", "path": [[0, 520, 698], [0.2, 560, 420]] },
              { "id": "p", "team": "us", "label": "4", "path": [[0, 440, 698], [0.2, 600, 540]], "faces": [[0, "up"]] },
              { "id": "a", "team": "them", "label": "A", "path": [[0, 500, 560], [0.2, 280, 430]] },
              { "id": "a2", "team": "them", "label": "B", "path": [[0, 420, 540], [0.2, 560, 330]] }
            ],
            "ball": [[0, 18, 430], [0.35, 18, 430], [0.58, 370, 585]],
            "lines": [{ "from": [30, 430], "to": [362, 575], "color": "white", "dashed": true, "t": [0.35, 0.58] }],
            "tags": [
              { "at": [120, 380], "text": "THROW-IN", "color": "white", "t": [0.12, 0.16] },
              { "at": [250, 680], "text": "FEET ONLY", "color": "amber", "size": 40, "t": [0.62, 0.66] }
            ]
          }
        },
        {
          "kicker": "You choose",
          "heading": "Header back?",
          "sub": "A team-mate heads it back to you. Hands or feet?",
          "countdown": 3,
          "vo": "Your team-mate heads it back to you. Hands, or feet?",
          "board": {
            "players": [
              { "id": "t", "team": "us", "label": "3", "path": [[0, 18, 470], [0.3, 150, 380]], "faces": [[0, "up"]] },
              { "id": "gk", "team": "keeper", "label": "GK", "path": [[0, 380, 600]] },
              { "id": "d", "team": "us", "label": "5", "path": [[0, 560, 420], [0.2, 520, 400]], "faces": [[0, "up"]] },
              { "id": "p", "team": "us", "label": "4", "path": [[0, 600, 540]], "faces": [[0, "up"]] },
              { "id": "a", "team": "them", "label": "A", "path": [[0, 280, 430], [0.3, 470, 330]] },
              { "id": "a2", "team": "them", "label": "B", "path": [[0, 560, 330]] }
            ],
            "ball": [[0, 600, 210], [0.3, 515, 345]],
            "bubbles": [{ "at": "d", "text": "HEADER", "t": [0.3, 0.36] }]
          }
        },
        {
          "kicker": "The answer",
          "heading": "Hands are OK",
          "sub": "Head, chest or knee: the keeper can pick it up.",
          "vo": "Hands are fine. The rule is only for kicks and throw-ins. If it comes off a team-mate's head, chest or knee, you can pick it up.",
          "board": {
            "players": [
              { "id": "t", "team": "us", "label": "3", "path": [[0, 150, 380]], "faces": [[0, "up"]] },
              { "id": "gk", "team": "keeper", "label": "GK", "path": [[0, 380, 600]] },
              { "id": "d", "team": "us", "label": "5", "path": [[0, 520, 400]], "faces": [[0, "up"]] },
              { "id": "p", "team": "us", "label": "4", "path": [[0, 600, 540]], "faces": [[0, "up"]] },
              { "id": "a", "team": "them", "label": "A", "path": [[0, 470, 330]] },
              { "id": "a2", "team": "them", "label": "B", "path": [[0, 560, 330]] }
            ],
            "ball": [[0, 515, 345], [0.25, 388, 560]],
            "marks": [{ "kind": "tick", "at": [460, 520], "t": [0.3, 0.34] }],
            "bubbles": [{ "at": "gk", "text": "KEEPER!", "color": "green", "below": true, "t": [0.26, 0.3] }]
          }
        },
        {
          "kicker": "Watch out",
          "heading": "No tricks",
          "sub": "Flicking it up just to head it back isn't allowed.",
          "vo": "No tricks, though. Flicking the ball up with your foot just to head it back is not allowed. The other team gets an indirect free kick where it happened, and the player who started the trick gets a yellow card.",
          "board": {
            "players": [
              { "id": "t", "team": "us", "label": "3", "path": [[0, 150, 380]], "faces": [[0, "up"]] },
              { "id": "gk", "team": "keeper", "label": "GK", "path": [[0, 380, 600]] },
              { "id": "d", "team": "us", "label": "5", "path": [[0, 520, 400]] },
              { "id": "p", "team": "us", "label": "4", "path": [[0, 600, 540]], "faces": [[0, "up"]] },
              { "id": "a", "team": "them", "label": "A", "path": [[0, 470, 330]] },
              { "id": "a2", "team": "them", "label": "B", "path": [[0, 560, 330]] }
            ],
            "ball": [[0, 510, 422], [0.2, 510, 422], [0.28, 510, 330], [0.36, 510, 345]],
            "tags": [
              { "at": [320, 250], "text": "FLICK UP, HEAD BACK", "color": "white", "t": [0.2, 0.24], "until": 0.5 },
              { "at": [320, 250], "text": "FREE KICK TO THEM", "color": "red", "size": 38, "t": [0.56, 0.6] }
            ],
            "marks": [{ "kind": "cross", "at": [585, 360], "t": [0.48, 0.52] }]
          }
        },
        {
          "kicker": "You choose",
          "heading": "Miskick?",
          "sub": "A team-mate tries to clear it, and slices it toward our goal.",
          "countdown": 3,
          "vo": "Your team-mate tries to kick it clear, but slices it toward our goal. Hands, or feet?",
          "board": {
            "players": [
              { "id": "t", "team": "us", "label": "3", "path": [[0, 150, 380]], "faces": [[0, "up"]] },
              { "id": "gk", "team": "keeper", "label": "GK", "path": [[0, 380, 600]] },
              { "id": "d", "team": "us", "label": "5", "path": [[0, 520, 400]], "faces": [[0, "up"]] },
              { "id": "p", "team": "us", "label": "4", "path": [[0, 600, 540]], "faces": [[0, "up"]] },
              { "id": "a", "team": "them", "label": "A", "path": [[0, 470, 330]] },
              { "id": "a2", "team": "them", "label": "B", "path": [[0, 560, 330]] }
            ],
            "ball": [[0, 510, 422]],
            "ballCurve": { "t": [0.15, 0.45], "from": [510, 422], "via": [660, 560], "to": [440, 610] },
            "lines": [{ "from": [510, 422], "to": [440, 610], "curve": [660, 560], "color": "white", "dashed": true, "t": [0.15, 0.45] }],
            "tags": [{ "at": [400, 300], "text": "SLICED CLEARANCE", "color": "white", "t": [0.1, 0.14] }]
          }
        },
        {
          "kicker": "The answer",
          "heading": "Hands are OK",
          "sub": "A miskick or a deflection isn't a pass back.",
          "vo": "Hands are fine. A miskick or a deflection isn't a pass to the keeper, so the keeper can pick it up.",
          "board": {
            "players": [
              { "id": "t", "team": "us", "label": "3", "path": [[0, 150, 380]], "faces": [[0, "up"]] },
              { "id": "gk", "team": "keeper", "label": "GK", "path": [[0, 380, 600], [0.2, 425, 605]] },
              { "id": "d", "team": "us", "label": "5", "path": [[0, 520, 400]], "faces": [[0, "up"]] },
              { "id": "p", "team": "us", "label": "4", "path": [[0, 600, 540]], "faces": [[0, "up"]] },
              { "id": "a", "team": "them", "label": "A", "path": [[0, 470, 330]] },
              { "id": "a2", "team": "them", "label": "B", "path": [[0, 560, 330]] }
            ],
            "ball": [[0, 440, 610], [0.2, 430, 572]],
            "marks": [{ "kind": "tick", "at": [500, 540], "t": [0.24, 0.28] }],
            "bubbles": [{ "at": "gk", "text": "KEEPER!", "color": "green", "below": true, "t": [0.2, 0.24] }]
          }
        },
        {
          "kicker": "For keepers",
          "heading": "Be good with your feet",
          "sub": "Most back-passes are feet only. Practise receiving with both feet.",
          "vo": "So keepers, most back-passes are feet only. That's why every keeper on our team practises receiving with both feet.",
          "board": {
            "players": [
              { "id": "t", "team": "us", "label": "3", "path": [[0, 150, 380], [0.5, 90, 480]], "faces": [[0, "up"]] },
              { "id": "gk", "team": "keeper", "label": "GK", "path": [[0, 425, 605], [0.15, 400, 620]] },
