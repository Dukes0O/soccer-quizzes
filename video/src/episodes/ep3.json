  "scenes": [
    {
      "type": "title",
      "id": "title",
      "vo": "Back to the Keeper. Episode three: how to pass it back. A good back-pass keeps the ball for your team. A bad one can give away a goal."
    },
    {
      "type": "steps",
      "id": "steps",
      "steps": [
        {
          "variant": "look",
          "heading": "Look first",
          "sub": "Keepers move. Pass to where your keeper is now.",
          "vo": "Step one. Look first. Keepers move. Before you pass back, check where your keeper is right now."
        },
        {
          "variant": "call",
          "heading": "The keeper calls it",
          "sub": "You can point. The keeper's call wins.",
          "vo": "Step two. Talk. You can shout keeper, and point. But your keeper has the best view, so the keeper's call wins. If your keeper shouts, yes, left side, that's where it goes. Away means kick it clear."
        },
        {
          "variant": "side",
          "heading": "Side, not middle",
          "sub": "Missed? A pass to the side rolls wide, not in.",
          "vo": "Step three. Side, not middle. Pass to the side of the goal, never at the middle. If it's missed, a pass to the side rolls wide. A pass to the middle rolls into your own net."
        },
        {
          "variant": "pace",
          "heading": "Firm, to the foot",
          "sub": "A slow pass lets the attacker get there first.",
          "vo": "Step four. Firm, to the foot. A slow pass lets the attacker get there first. Pass it firm, to your keeper's stronger foot."
        },
        {
          "variant": "keeper",
          "heading": "Keepers: move!",
          "sub": "Step up to the edge of the box, or out to the side of the goal.",
          "vo": "Keepers, this part is for you. Don't stay on your goal line. Step up to the edge of your box, or out to the side of the goal. Then your defenders know where to look, and you have time on the ball."
        }
      ]
    },
